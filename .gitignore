# =====================================================================
# 语音唤醒系统 .gitignore
#
# 原则：只提交"人写的"东西（源码、配置模板、文档、分区表、依赖锁），
#      不提交构建产物、第三方依赖、模型权重、含密钥的本地配置。
# =====================================================================

# ---------------------------------------------------------------------
# 1. 密钥 / 个人配置（最重要：config.json 里有真实 api_key）
# ---------------------------------------------------------------------
host/config.json
host/ui_state.json
*.local.json
.env
.env.*

# 说明：
#   config.json 首次运行会自动生成，所以不需要入库；
#   要给别人参考格式，就照 host/docs/04_配置说明.md 里的骨架复制。

# ---------------------------------------------------------------------
# 2. 模型权重（体积大、按需下载，不入库）
# ---------------------------------------------------------------------
host/models/
# 兼容有人把模型放在项目根的情况
/models/
*.onnx
*.onnx.json
*.pt
*.ct2
*.gguf

# 说明：
#   faster-whisper 的 model.bin 在 host/models/ 下，已被上面的目录规则覆盖；
#   esp-sr 的 srmodels.bin 生成在 firmware/build/srmodels/，由下面的 build/ 规则覆盖。
#   这里不加 *.bin 通配，避免误伤以后可能入库的固件二进制。

# ---------------------------------------------------------------------
# 3. ESP-IDF 构建产物
# ---------------------------------------------------------------------
firmware/build/
firmware/test/*/build/
# 任意层级的 build 目录（防止新增测试工程时漏掉）
build/

# 生成型配置文件：由 sdkconfig.defaults + menuconfig 产生
firmware/sdkconfig
firmware/sdkconfig.old
firmware/test/*/sdkconfig
firmware/test/*/sdkconfig.old
sdkconfig
sdkconfig.old

# 保留：
#   firmware/sdkconfig.defaults        ← 工程默认值，必须提交
#   firmware/dependencies.lock         ← 依赖解析结果，必须提交（保证可复现）
#   firmware/partitions.csv            ← 分区表，必须提交

# 组件管理器下载的第三方组件（首次 build 自动拉取）
firmware/managed_components/
managed_components/

# 编译日志
firmware/log.txt
*.log
!docs/**/*.log

# ESP-IDF 生成的 clangd 索引配置（内容是本机绝对路径，换机器就没意义）
.clangd
firmware/.clangd

# ---------------------------------------------------------------------
# 4. Python
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build-python/
dist/
*.egg-info/
.eggs/

# 虚拟环境
.venv/
venv/
env/
ENV/
.conda/

# 测试与类型检查缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------
# 5. 运行时产物
# ---------------------------------------------------------------------
logs/
*.pcm
*.wav
*.mp3
*.m4a

# ---------------------------------------------------------------------
# 6. 编辑器 / 系统
# ---------------------------------------------------------------------
.vscode/
.idea/
*.code-workspace
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------
# 7. 本项目的辅助目录
# ---------------------------------------------------------------------
# 对话/工作记录（体积不大但属于个人上下文，不随仓库分发）
.workbuddy/

# ---------------------------------------------------------------------
# 8. 如果想要更小的仓库，可以额外取消下面两行的注释
#    （芯片手册 4.7MB，是参考资料，保留或排除都合理）
# ---------------------------------------------------------------------
SensorMaterial/
