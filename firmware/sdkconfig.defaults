# =====================================================================
# 工程默认配置（仅在 sdkconfig 不存在 / 执行 reconfigure 时生效）
# 若本地已有 sdkconfig，需 `idf.py fullclean` 或删除 sdkconfig 后重新生成，
# 否则新增项不会自动套用（本项目 v0.4.0 即因该原因导致模型选项与文档不一致）。
# =====================================================================

# ===== 目标芯片 =====
CONFIG_IDF_TARGET="esp32s3"

# ===== CPU 频率 =====
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# ===== Flash：实测 16MB（日志中 "Detected size(16384k)"）=====
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# ===== 自定义分区表 =====
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# ===== PSRAM：ESP32-S3 板载 8MB Octal，AFE 高性能模式强依赖 =====
# 若板子是 Quad PSRAM（如 N8R2），把 SPIRAM_MODE_OCT 换成 SPIRAM_MODE_QUAD，
# 否则启动阶段 PSRAM 初始化失败会直接 abort。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# ===== Cache：esp-sr 要求 data cache >= 64KB、cache line 64B =====
# （原配置 32KB/32B 会触发 "Data cache recommends 64KB/64B" 警告并拖慢 WakeNet）
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ===== 主任务栈（音频/网络任务建议加大）=====
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ===== esp-sr：AFE + WakeNet，模型从 flash 分区加载 =====
CONFIG_USE_AFE=y
CONFIG_AFE_INTERFACE_V1=y
# 模型不编译进固件，而是打包成 srmodels.bin 由 idf.py flash 写入 model 分区，
# 运行期必须调用 esp_srmodel_init("model") 才会被注册（否则唤醒句柄为 NULL）
CONFIG_MODEL_IN_FLASH=y
CONFIG_USE_WAKENET=y
CONFIG_SR_WN_WN9_HILEXIN=y
# 本项目未使用命令词识别（MultiNet），关闭后可让 srmodels.bin 从 ~3.9MB 降到 ~0.3MB
CONFIG_SR_MN_CN_NONE=y

# ===== 日志级别（联调时可设 DEBUG）=====
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
